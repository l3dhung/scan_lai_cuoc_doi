{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Scan lại cuộc đời",
  "slug": "document-scanner",
  "version": "1.0.4",
  "description": "Scan paper documents, correct perspective, organize pages, and create submission-ready PDFs entirely in your browser.",
  "defaultLanguage": "en",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-document-scanner"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    }
  }
}
