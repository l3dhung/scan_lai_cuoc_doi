{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Life-scanner",
  "slug": "document-scanner",
  "version": "1.0.4",
  "description": "Life-scanner: chụp giấy tờ, nắn phẳng, sắp trang và xuất PDF ngay trên máy, không gửi gì đi đâu.",
  "defaultLanguage": "vi",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-document-scanner"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    }
  }
}
